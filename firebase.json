{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.md"
    ],
    "rewrites": [
      { "source": "/stkpush", "function": "stkpush" },
      { "source": "/callback", "function": "callback" }
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|png|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
